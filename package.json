{
  "name": "ai-treasury-council",
  "version": "0.1.0",
  "private": true,
  "description": "AI Treasury Council - multi-agent DAO governance with on-chain audit trail",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:api": "cd apps/api && uvicorn main:app --reload --port 8000",
    "dev:contracts": "cd contracts && anvil",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter web test",
    "test:e2e": "cd tests && npx playwright test --project=e2e",
    "test:integration": "cd tests && npx playwright test --project=integration",
    "test:smoke": "./tests/smoke/post-deploy.sh",
    "test:api": "cd apps/api && pytest",
    "test:contracts": "cd contracts && forge test -vvv",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "mint-ens-subnames": "tsx scripts/mint-ens-subnames.ts",
    "update-reputation-snapshot": "tsx scripts/update-reputation-snapshot.ts"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "tsx": "^4.19.2",
    "viem": "^2.21.55"
  }
}
