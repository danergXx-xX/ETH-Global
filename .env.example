# Skopiuj to .env i wypelnij PRZED uruchomieniem.
# .env JEST w .gitignore - nigdy nie commit secrets.

# ============================================
# AI - Anthropic (Claude API dla CrewAI agents)
# ============================================
ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================
# Blockchain - Base Sepolia testnet
# ============================================
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Alt: https://sepolia.base.org (public, slower)

# Foundry deployer key - WYGENERUJ NOWY tylko na hackathon
# Uzyj: cast wallet new
# NIGDY nie uzywaj swojego osobistego klucza nawet na testnet
DEPLOYER_PRIVATE_KEY=0x...

# Etherscan/Basescan API key (do verify deployed contracts)
ETHERSCAN_API_KEY=

# ============================================
# Sponsor integrations
# ============================================
# 0G Storage (audit trail)
ZERO_G_STORAGE_KEY=
ZERO_G_RPC_URL=

# NameStone (ENS subnames - Phase 2)
NAMESTONE_API_KEY=
NAMESTONE_DOMAIN=aicouncil.eth

# Storage fallback (jesli 0G fail)
STORAGE_PROVIDER=0g  # 0g | ipfs
WEB3_STORAGE_TOKEN=  # opcjonalne, fallback IPFS

# ============================================
# Backend (apps/api)
# ============================================
DATABASE_URL=postgresql://localhost:5432/aicouncil
REDIS_URL=redis://localhost:6379

# ============================================
# Frontend (apps/web) - PUBLIC env vars
# ============================================
# WalletConnect project ID (PUBLIC - bezpieczne w bundle)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Backend URL (PUBLIC)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# Observability (opcjonalne)
# ============================================
SENTRY_DSN_FRONTEND=
SENTRY_DSN_BACKEND=

# ============================================
# Data sources (Phase 3)
# ============================================
COINGECKO_API_KEY=  # opcjonalne, free tier bez key
PERPLEXITY_API_KEY=  # opcjonalne stretch
